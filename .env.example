# Where the Floodline backend (FastAPI) runs. The Vite dev/preview server
# proxies /api/* to this address, so the browser never makes a cross-origin
# request and the backend needs no CORS configuration.
API_PROXY_TARGET=http://localhost:8000

# Optional: bypass the proxy and call a backend directly from the browser.
# That backend must then send CORS headers for the frontend's origin.
# VITE_API_URL=http://localhost:8000

# Optional: Overpass endpoint used only by `pnpm geo:fetch` (not at runtime).
# OVERPASS_URL=https://overpass-api.de/api/interpreter

# ----------------------------------------------------------------------------
# Backend (src/floodline). Read from the process environment with os.environ;
# the backend does NOT load this file itself. Locally, export them before
# `floodline serve` / scripts/serve-public.sh (e.g. `set -a; source .env; set +a`).
# ----------------------------------------------------------------------------

# Where data and models live.
FLOODLINE_DATA=data
FLOODLINE_MODELS=models

# Copernicus Global Flood Monitoring (live Sentinel-1 observed flood).
# Free account: https://portal.gfm.eodc.eu — without these the satellite layer
# reports "unavailable".
# GFM_USER=
# GFM_PASS=

# Copernicus Data Space Sentinel-2 WMS (the Imagery toggle).
# CDSE_CLIENT_ID=            # configuration instance ID
# CDSE_WMS_LAYER=TRUE_COLOR
# CDSE_MAX_CLOUD=30

# Open-Meteo paid key (optional): customer endpoints + 0.25° rain grid.
# OPEN_METEO_API_KEY=
# FLOODLINE_RAIN_GRID=0.5    # override the rain grid in degrees

# Ask Floodline: local open-weights LLM via Ollama (`ollama pull qwen3:8b`).
# OLLAMA_URL=http://localhost:11434
# FLOODLINE_LLM_MODEL=qwen3:8b

# Extra allowed browser origins, comma-separated (only when using VITE_API_URL).
# FLOODLINE_CORS_ORIGINS=https://floodline.onrender.com
